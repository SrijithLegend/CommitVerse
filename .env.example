# Commitverse environment (§15). Validated at boot by packages/contracts/src/env.ts.
# Local development needs NONE of these: `pnpm dev` runs zero-config local mode
# (embedded Postgres under .data/, synthetic universe, dev sign-in, mock payments).
# In production (NODE_ENV=production) every variable marked [required] must be set or the process refuses to start.

APP_URL=https://commitverse.example                     # [required] public origin

# ── Database / Supabase ─────────────────────────────────────────────
DATABASE_URL=                                           # [required] direct connection (not the pooler) — worker + web
NEXT_PUBLIC_SUPABASE_URL=                               # [required]
NEXT_PUBLIC_SUPABASE_ANON_KEY=                          # [required]
SUPABASE_SERVICE_ROLE_KEY=                              # [required] server only — never NEXT_PUBLIC
SESSION_SECRET=                                         # [required] 32+ random bytes (openssl rand -base64 48)

# ── GitHub ──────────────────────────────────────────────────────────
GITHUB_APP_ID=                                          # [required]
GITHUB_APP_PRIVATE_KEY=                                 # [required] PEM, newlines as \n
GITHUB_APP_INSTALLATION_ID=                             # [required]
GITHUB_WEBHOOK_SECRET=                                  # [required]
GITHUB_OAUTH_CLIENT_ID=                                 # configured in Supabase Auth → GitHub
GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_TOKEN=                                         # local only: lets `pnpm dev` materialize real users

# ── Sync-token encryption (§11.2) ───────────────────────────────────
TOKEN_ENC_ACTIVE_KID=k1                                 # [required]
TOKEN_ENC_KEY_k1=                                       # [required] base64 32 bytes (openssl rand -base64 32)

# ── Redis (rate limits, leaderboards) ───────────────────────────────
UPSTASH_REDIS_REST_URL=                                 # [required]
UPSTASH_REDIS_REST_TOKEN=                               # [required]

# ── Tiles on R2 (zero egress) ───────────────────────────────────────
R2_ACCOUNT_ID=                                          # [required]
R2_ACCESS_KEY_ID=                                       # [required]
R2_SECRET_ACCESS_KEY=                                   # [required]
R2_BUCKET=                                              # [required]
NEXT_PUBLIC_TILES_BASE_URL=https://tiles.commitverse.example   # [required]

# ── Realtime (Cloudflare Durable Objects) ───────────────────────────
NEXT_PUBLIC_REALTIME_URL=wss://realtime.commitverse.example
REALTIME_SHARED_SECRET=                                 # same value as `wrangler secret put REALTIME_SHARED_SECRET`

# ── Payments (§F7) — stripe | paddle (mock is refused in production) ─
PAYMENT_PROVIDER=paddle                                 # [required]
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=production

# ── Email / anti-abuse / observability ──────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Commitverse <hello@commitverse.example>
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                                      # CI only (source maps, releases)
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ── Operations ──────────────────────────────────────────────────────
ADMIN_GITHUB_LOGINS=                                    # comma-separated allow-list
BAKE_CRON=0 2 * * *
LAUNCH_DATE=2026-10-01                                  # early_universe achievement window
