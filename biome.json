{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["**", "!**/node_modules", "!**/.next", "!**/dist", "!**/*.json", "!**/__snapshots__", "!**/.turbo", "!**/public/u"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off", "noParameterAssign": "off" },
      "suspicious": { "noExplicitAny": "warn", "noArrayIndexKey": "off" },
      "complexity": { "noForEach": "off" },
      "a11y": { "noSvgWithoutTitle": "off" }
    }
  }
}
