{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/*.json",
      "!**/__snapshots__",
      "!**/.turbo",
      "!**/.wrangler",
      "!**/test-results",
      "!**/playwright-report",
      "!**/public/u",
      "!**/next-env.d.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "css": { "parser": { "tailwindDirectives": true } },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off", "noParameterAssign": "off" },
      "suspicious": { "noExplicitAny": "warn", "noArrayIndexKey": "off" },
      "complexity": { "noForEach": "off" },
      "a11y": { "noSvgWithoutTitle": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/ui/**", "packages/ui-kit/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "noNoninteractiveElementToInteractiveRole": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    }
  ]
}
